generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   Student?
  faculty   Faculty?
}

model Department {
  id    String @id @default(uuid())
  name  String @unique
  years Year[]
}

model Year {
  id           String     @id @default(uuid())
  year         Int
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sections     Section[]

  @@unique([year, departmentId])
}

model Section {
  id       String    @id @default(uuid())
  section  String
  yearId   String
  year     Year      @relation(fields: [yearId], references: [id], onDelete: Cascade)
  subjects Subject[]

  @@unique([section, yearId])
}

model Subject {
  id        String  @id @default(uuid())
  name      String
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [facultyId])

  @@unique([name, sectionId])
}

model Student {
  id         String        @id @default(uuid())
  studentId  String        @unique
  name       String?
  department String
  year       Int
  section    String
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  records    NoDueRecord[]
}

model Faculty {
  id        String        @id @default(uuid())
  facultyId String        @unique
  name      String?
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  records   NoDueRecord[]
  subjects  Subject[]
}

model NoDueRecord {
  id        String   @id @default(uuid())
  studentId String
  facultyId String
  subject   String
  status    String   @default("pending")
  message   String?
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subject])
}
